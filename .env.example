# API Configuration
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ecommerce_dev

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# JWT Auth
JWT_ACCESS_SECRET=your_access_token_secret_key_here
JWT_REFRESH_SECRET=your_refresh_token_secret_key_here
JWT_ACCESS_EXPIRATION=900s
JWT_REFRESH_EXPIRATION=604800s

# Bcrypt
BCRYPT_SALT=10

# VNPay Payment Gateway
VNPAY_TMN_CODE=2CEX1U39
VNPAY_HASH_SECRET=your_vnpay_hash_secret_here
VNPAY_API_URL=https://sandbox.vnpayment.vn
VNPAY_RETURN_URL=https://your-domain.ngrok-free.dev/payments/payment-return

# File Upload
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# Email (Mock/Real)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SENDER_EMAIL=noreply@ecommerce.local

# Logging
LOG_LEVEL=debug

# Feature Flags
ENABLE_PAYMENT_RETRY=true
ENABLE_RECONCILIATION_JOB=false
